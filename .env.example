# ─── Backend connection (required) ───────────────────────────────────────────
# Point at the running chains-api instance and the storefront key for this store.
CHAINS_API_URL=https://api.chains-erp.com
CHAINS_STOREFRONT_KEY=sk_sf_xxx

# ─── Site URL (required) ─────────────────────────────────────────────────────
# Full public URL of this storefront — used for payment callback/redirect URLs.
NEXT_PUBLIC_SITE_URL=https://store.example.com

# ─── Session secret (required) ───────────────────────────────────────────────
# Must match NEXTAUTH_SECRET in chains-api so customer JWTs verify on both sides.
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─── Card payments — Paystack (optional) ─────────────────────────────────────
# Enable card payments by adding 'card' to paymentMethods in storefront.config.ts,
# then fill in the Paystack secret key below. The public key is not needed server-side.
# Point your Paystack dashboard webhook at: <NEXT_PUBLIC_SITE_URL>/api/storefront/paystack/webhook
PAYSTACK_SECRET_KEY=sk_live_xxx

# ─── Address autocomplete at checkout (optional) ─────────────────────────────
# Free Geoapify key from https://myprojects.geoapify.com/ — server-side only.
# Without it, autocomplete falls back to free Photon (komoot); plain text still works.
GEOAPIFY_KEY=
# Bias address results to a country (ISO-2 code), e.g. ke for Kenya.
NEXT_PUBLIC_GEO_COUNTRY=ke

# ─── Branding (optional) ─────────────────────────────────────────────────────
# Hero image and logo. Drop hero.* / logo.* in /public, or point these at an
# external URL. Leave blank and the store's own backend values / default gradient are used.
NEXT_PUBLIC_HERO_IMAGE=
NEXT_PUBLIC_LOGO_IMAGE=

# ─── Money (optional) ────────────────────────────────────────────────────────
# Currency comes from the store automatically; this is a last-resort fallback only.
NEXT_PUBLIC_STORE_CURRENCY=KES
# Only set true for Fleetbase backends that return minor units (cents). Chains uses
# whole units so leave this false.
NEXT_PUBLIC_MONEY_MINOR_UNITS=false

# ─── Fleetbase delivery dispatch (optional, advanced) ────────────────────────
# Only needed when running Fleetbase delivery dispatch ON TOP of chains-api.
# Set FLEETBASE_ENABLED=true and provide the keys below to activate.
FLEETBASE_ENABLED=false
FLEETBASE_HOST=https://api.fleetbase.io
STOREFRONT_KEY=

# ─── UI / theme (optional) ───────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_THEME=default
NEXT_PUBLIC_IMAGE_HOSTS=

# ─── Real-time order tracking (optional) ─────────────────────────────────────
NEXT_PUBLIC_SOCKETCLUSTER_HOST=
NEXT_PUBLIC_SOCKETCLUSTER_PORT=
NEXT_PUBLIC_SOCKETCLUSTER_SECURE=true

# ─── Payment methods ─────────────────────────────────────────────────────────
# Configured in storefront.config.ts — NOT here. Edit the paymentMethods object
# in that file to enable/disable mpesa, bank, card, cash, bitcoin.
