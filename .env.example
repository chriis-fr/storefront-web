# Required Fleetbase Storefront settings
FLEETBASE_HOST=https://api.fleetbase.io
STOREFRONT_KEY=store_xxx_or_network_xxx

# Public website settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_THEME=default
NEXT_PUBLIC_IMAGE_HOSTS=api.fleetbase.io
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_PROMO_BANNER=

# Optional real-time tracking
NEXT_PUBLIC_SOCKETCLUSTER_HOST=
NEXT_PUBLIC_SOCKETCLUSTER_PORT=
NEXT_PUBLIC_SOCKETCLUSTER_SECURE=true

CHAINS_API_URL=http://localhost:4000
CHAINS_STOREFRONT_KEY=sk_sf_4ad167693666b6fb82429e6b08a4d3252276549f
FLEETBASE_ENABLED=FALSE

# Payment methods offered at checkout (dynamic, per instance).
# Comma list of: mpesa, bank, cash, bitcoin, card. When set, this is authoritative;
# when unset, methods are derived from the store's POS settings.
# Cash is OFF by default — only shown if listed here (or NEXT_PUBLIC_ENABLE_CASH=true
# when no list is set). Bank / till-less M-Pesa are routed to the app treasury by
# the backend and settled to the store.
NEXT_PUBLIC_PAYMENT_METHODS=mpesa,bank
# Enable cash only when NEXT_PUBLIC_PAYMENT_METHODS is unset (list takes priority).
NEXT_PUBLIC_ENABLE_CASH=false

# Address autocomplete + reverse geocoding at checkout (Geoapify).
# Free key (no billing card) from https://myprojects.geoapify.com/ — server-side only.
# Without it, the address field still works as plain text + "use my location" (coords only).
GEOAPIFY_KEY=
# Optional: bias autocomplete to a country (ISO code), e.g. ke for Kenya.
NEXT_PUBLIC_GEO_COUNTRY=
